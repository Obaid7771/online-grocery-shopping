# =============================================================================
# FreshCart Admin Dashboard - Production Environment Configuration
# =============================================================================
# SECURITY NOTICE: Never commit actual values. Copy this to .env.production.local
# and fill in with secure production values.
# =============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=https://api.freshcart.com/api/v1

# App URL (for SSR and redirects)
NEXT_PUBLIC_APP_URL=https://admin.freshcart.com

# Auth Cookie Settings
NEXT_PUBLIC_AUTH_COOKIE_NAME=freshcart_admin_token
NEXT_PUBLIC_AUTH_COOKIE_SECURE=true
NEXT_PUBLIC_AUTH_COOKIE_SAME_SITE=strict

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true

# Sentry Error Tracking
SENTRY_DSN=https://xxxxxxxx@o1234567.ingest.sentry.io/1234567
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
