# FreshCart Backend Environment Variables

# Node & Server
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/freshcart_db?schema=public"

# JWT Secrets (Minimum 256-bit cryptographically secure strings in production)
JWT_SECRET=freshcart_jwt_access_secret_super_secure_key_2026_dev
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=freshcart_jwt_refresh_secret_ultra_secure_key_2026_dev
JWT_REFRESH_EXPIRATION=30d

# Payment Gateways (Stripe Sandbox & PayPal Sandbox)
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForDevelopmentOnly
STRIPE_PUBLISHABLE_KEY=pk_test_51MockStripePublishableKeyForDevelopmentOnly
STRIPE_WEBHOOK_SECRET=whsec_MockStripeWebhookSigningSecret2026
PAYPAL_CLIENT_ID=mock_paypal_client_id_for_sandbox
PAYPAL_CLIENT_SECRET=mock_paypal_client_secret_for_sandbox

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=freshcart-grocery-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@freshcart-grocery-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMOCK_KEY\n-----END PRIVATE KEY-----"

# S3 / MinIO Object Storage
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret_password
AWS_BUCKET_NAME=freshcart-media
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Throttler / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120
