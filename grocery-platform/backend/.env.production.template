# =============================================================================
# FreshCart Backend - Production Environment Configuration
# =============================================================================
# SECURITY NOTICE: Never commit actual values. Copy this to .env.production
# and fill in with secure production values.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# Database Configuration
# Use a managed PostgreSQL service (AWS RDS, Google Cloud SQL, etc.)
# Ensure SSL is enabled and connection is encrypted
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/freshcart_prod?schema=public&sslmode=require"

# -----------------------------------------------------------------------------
# JWT Configuration
# CRITICAL: Generate strong random secrets (min 64 characters)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_SECRET"

# -----------------------------------------------------------------------------
# CORS Configuration
# Only allow your production domains
# -----------------------------------------------------------------------------
CORS_ORIGIN="https://admin.freshcart.com,https://api.freshcart.com"

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# Adjust based on expected traffic
# -----------------------------------------------------------------------------
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=50
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=200

# -----------------------------------------------------------------------------
# Stripe Payment Configuration
# Use live keys, NOT test keys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_XXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_WEBHOOK_SECRET="whsec_XXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_PUBLISHABLE_KEY="pk_live_XXXXXXXXXXXXXXXXXXXXXXXX"

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging
# Download service account JSON from Firebase Console
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID="freshcart-production"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@freshcart-production.iam.gserviceaccount.com"

# -----------------------------------------------------------------------------
# File Storage (AWS S3)
# Use IAM roles in production for better security
# -----------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
AWS_S3_BUCKET="freshcart-prod-assets"

# -----------------------------------------------------------------------------
# Redis Configuration (for sessions, caching, rate limiting)
# Use managed Redis (AWS ElastiCache, Redis Cloud, etc.)
# -----------------------------------------------------------------------------
REDIS_HOST="redis-cluster.xxxxx.cache.amazonaws.com"
REDIS_PORT=6379
REDIS_PASSWORD="XXXXXXXXXXXXXXXXXXXXXXXX"
REDIS_TLS_ENABLED=true

# -----------------------------------------------------------------------------
# Email Service (SendGrid, AWS SES, etc.)
# -----------------------------------------------------------------------------
MAIL_HOST="smtp.sendgrid.net"
MAIL_PORT=587
MAIL_USER="apikey"
MAIL_PASSWORD="SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
MAIL_FROM="noreply@freshcart.com"

# -----------------------------------------------------------------------------
# Logging Configuration
# Use structured logging in production
# -----------------------------------------------------------------------------
LOG_LEVEL="info"
LOG_FORMAT="json"

# -----------------------------------------------------------------------------
# Sentry Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN="https://xxxxxxxx@o1234567.ingest.sentry.io/1234567"

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
HEALTH_CHECK_MAX_HEAP_MB=500
HEALTH_CHECK_MAX_RSS_MB=1000

# -----------------------------------------------------------------------------
# Security Headers
# -----------------------------------------------------------------------------
HSTS_MAX_AGE=31536000
CSP_REPORT_URI="https://api.freshcart.com/csp-report"
